BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=change-me-to-a-random-string
# https://auth.abuse.ch/ で無料発行されるURLhaus APIのAuth-Key。未設定でも動作するが、
# その場合はURLhaus照会が常にスキップされfail-open(securityStatus: 'unscanned')になる
URLHAUS_API_KEY=
# Cloudflare Turnstileのシークレットキー(サーバー側検証用)。docs/architecture.md参照。
# ローカル開発では公式のテスト用シークレットキー(常に成功: 1x0000000000000000000000000000000AA)を
# 設定する。本番用のキーはCloudflareダッシュボードでウィジェットを作成して発行する
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Cloudflare Turnstileのサイトキー(警告ページの通報フォーム側で埋め込むウィジェット用。
# 公開情報のため値自体は秘匿不要だが、サーバー側でHTMLに埋め込むため他の設定と同様に
# ここで管理する)。ローカル開発では公式のテスト用サイトキー(常に成功: 1x00000000000000000000AA)を
# 設定する。src/frontend側(サインアップ画面)の.envにあるVITE_TURNSTILE_SITE_KEYと同じ値にする
TURNSTILE_SITE_KEY=1x00000000000000000000AA
