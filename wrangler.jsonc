{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kyurl-link",
	"compatibility_date": "2025-08-03",
	// Better Authがnode:crypto等のNode.js組み込みモジュールを使うため有効化する
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./src/index.tsx",
	// React Router(data mode)によるフロントエンドSPAの静的アセット配信設定。
	// directoryはvite buildのクライアント側出力先(@cloudflare/vite-pluginのデフォルト)。
	// not_found_handling: "single-page-application" により、ASSETS binding経由で
	// 一致する静的ファイルが無いパスを問い合わせるとindex.html(SPAのシェル)にフォールバックする。
	// run_worker_first: trueにより、静的アセットへの振り分けより先に必ずWorker(Hono)の
	// fetchハンドラを通す。これが無いと、/api/v1/linksのようなAPIパスも「一致する
	// 静的ファイルが無い」と判定されてindex.htmlに直接フォールバックされ、Workerに
	// 一切届かなくなってしまう(/:shortCodeのリダイレクトも同様)。
	// Worker側(src/index.tsx)では、/api/*・/:shortCode(短縮コードとして解釈できるもの)
	// 以外の全パスをASSETS bindingへ委譲する(詳細はsrc/index.tsxのコメントを参照)
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kyurl-link-prod",
			"database_id": "dce7140f-9c83-4152-b681-aab89f886238",
			// drizzle-kit generateの出力先(drizzle.config.tsのout)と揃える
			"migrations_dir": "./drizzle"
		}
	],
	"r2_buckets": [
		{
			// docs/architecture.md 第7節・第13節: 掲示物PDF/PNGキャッシュ用のR2バケット
			"binding": "POSTER_CACHE",
			"bucket_name": "kyurl-link-posters"
		}
	],
	// docs/architecture.md 第13節: 掲示物PDF/PNG生成に使うBrowser Rendering
	"browser": {
		"binding": "BROWSER"
	},
	// docs/architecture.md 第14.1節で「Workers Logs(observability.enabled = true)を
	// 原因調査用途として使う」と既に決定されていたが、実装が漏れていたための対応
	"observability": {
		"enabled": true
	},
	// docs/architecture.md 第7.1節「⑤物理削除バッチ」: 1日1回のCron Triggerで
	// deletedAt < now() - 7日のレコードを検出し、D1から物理削除するために使う
	"triggers": {
		"crons": ["0 0 * * *"]
	},
	// docs/architecture.md 第7.1節「④通知メール」: 申請受付時・完全削除完了時の通知メールを
	// Cloudflare Email Service(no-reply@kyurl.link)経由で送信するために使う
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["no-reply@kyurl.link"]
		}
	],
	// docs/architecture.md 第7節・第12節: linkClicksリソース(クリック統計)を
	// Workers Analytics Engineデータセットとして記録するために使う
	"analytics_engine_datasets": [
		{
			"binding": "LINK_CLICKS",
			"dataset": "link_clicks"
		}
	],
	"vars": {
		// docs/architecture.md 第7節「GET /links/:id/clicks: クリック統計(Analytics Engine SQL
		// APIへの問い合わせ)」で、SQL APIのエンドポイントURLを組み立てるために使うアカウントID
		"ACCOUNT_ID": "919b89c551eef0eed83ef419caf397de"
	}
}