{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext"
    ],
    // "@cloudflare/vitest-plugin" はcloudflareTest等のAPI型、"@cloudflare/vitest-plugin/types" は
    // "cloudflare:test"(env・SELFなど)のアンビエント型を提供するため、両方を型解決対象に含める
    "types": ["vite/client", "@cloudflare/vitest-plugin", "@cloudflare/vitest-plugin/types"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // worker-configuration.d.ts は `pnpm cf-typegen` (wrangler types) で生成される型定義ファイル。
  // CloudflareBindings等のバインディング型をテストコードからも参照できるようinclude対象に含める
  "include": ["src/**/*", "test/**/*", "*.config.ts", "worker-configuration.d.ts"],
}